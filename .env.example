# Copy this file to `.env` before starting the database.
# On Windows the setup script does it for you: scripts\setup.ps1

# Password for the Oracle SYSTEM account (used only to install the schema).
# Must be at least 8 characters and contain a digit.
ORACLE_PWD=admin123

# Optional: rename the container if `cikgu-oracle` is already taken.
ORACLE_CONTAINER_NAME=cikgu-oracle

# Optional: use a different host port if 1521 is already in use.
# If you change this, also set CIKGU_DB_PORT to the same value when
# running the Django app.
ORACLE_HOST_PORT=1521
